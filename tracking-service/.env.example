# LifeLink Tracking Service — environment template.
# Copy to `.env` for local development. On Render, set these in the dashboard
# (or via render.yaml) — never commit real values.

# Port the HTTP/WebSocket server binds to.
PORT=8080

# Production (Render): a real Redis instance is REQUIRED.
# REDIS_URL=rediss://default:password@host:port

# Firebase project used for ID-token verification + Firestore room lookups.
FIREBASE_PROJECT_ID=blood-donor-finder-744dd

# Optional: path to a service account JSON for Firebase Admin.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Tuning (optional, sensible defaults):
# TRACKING_IDLE_TIMEOUT_MS=900000
# TRACKING_RATE_LIMIT_PER_SECOND=1
